{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "daily-tasks-manager",
  "main": "./artifacts/daily-tasks-manager/src/worker.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": [
    "nodejs_compat",
    "enable_nodejs_http_server_modules"
  ],
  "keep_vars": true,
  "assets": {
    "binding": "ASSETS",
    "directory": "./artifacts/daily-tasks-manager/dist/client/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "daily-tasks-manager",
      "database_id": "05dbac29-3ca6-47d1-aff0-d26604c6c593",
      "migrations_dir": "./lib/db/migrations"
    }
  ]
}
